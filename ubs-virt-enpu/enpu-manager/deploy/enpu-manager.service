[Unit]
Description=ENPU Manager Service
Documentation=https://github.com/enpu-manager
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Environment
Environment=LD_LIBRARY_PATH=/usr/local/Ascend/cann/lib64:/usr/local/Ascend/driver/lib64/driver

# Runtime
ExecStart=/usr/bin/enpu-manager
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# File descriptors
LimitNOFILE=65536
LimitNPROC=65536

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target